{
  "name": "@million-beers/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply million-beers-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply million-beers-production --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
